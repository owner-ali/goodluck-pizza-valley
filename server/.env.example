PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/goodluck
# REQUIRED: 24+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
# Used only by `npm run seed:admin`. Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# PLACEHOLDER default in PKR. The owner changes the real fee in the admin panel.
DELIVERY_FEE=0
